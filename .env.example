# MEDIA_SIGNING_SECRET — required in production.
# HMAC secret used to sign short-lived /api/media capability tokens
# (pins the exact media URL + mode so the proxy can never act as an open relay).
# Generate with: openssl rand -hex 32
MEDIA_SIGNING_SECRET=change-me-openssl-rand-hex-32

# ------------------------------------------------------------------
# Optional — external media conversion worker (see /worker README).
# When unset, HLS/DASH rows show an honest "conversion not configured"
# state instead of a button that would fail.
# MEDIA_WORKER_URL=https://worker.example.com:8080
# WORKER_SECRET=long-random-string-shared-with-the-worker

# ------------------------------------------------------------------
# Optional tuning (sensible defaults are built in):
# RATE_LIMIT_BURST=12            # extract: burst per client/IP (per instance)
# RATE_LIMIT_PER_MIN=20          # extract: sustained per minute
# EXTRACT_BURST=8
# EXTRACT_PER_MIN=12
# MEDIA_BURST=120
# MEDIA_PER_MIN=120
# JOBS_BURST=3
# JOBS_PER_MIN=4
# FETCH_TIMEOUT_MS=15000         # upstream page/API timeout
# MEDIA_FETCH_TIMEOUT_MS=20000
# MAX_PAGE_BYTES=3145728         # cap for fetched pages/playlists (3 MB)
# PROXY_DOWNLOAD_MAX_BYTES=367003200  # max download proxied via the function (~350 MB)
# PROXY_DOWNLOAD_MAX_BYTES is also the threshold where /api/media switches a
# dl=1 request from proxy to plain redirect (large files exceed function time).

# Worker-side (worker/.env):
# PORT=8080
# WORKER_SECRET=...
# MAX_FILE_MB=4096
# MAX_CONCURRENT=2
# CONVERSION_MODE=auto           # auto | copy | transcode
# JOB_TTL_MIN=120
